###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_to_a_long_random_string
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Public URL of the site (IP or domain). Used when generating URLs from CLI.
DEFAULT_URI=http://YOUR_SERVER_IP
###< symfony/routing ###

###> docker / postgres ###
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=change_me_db_password
# Host "db" is the Compose service name. Keep user/password in sync with POSTGRES_*.
DATABASE_URL="postgresql://booking:change_me_db_password@db:5432/booking?serverVersion=16&charset=utf8"
###< docker / postgres ###

###> docker / rabbitmq ###
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=change_me_rabbit_password
###< docker / rabbitmq ###

###> symfony/messenger ###
# Keep credentials in sync with RABBITMQ_USER / RABBITMQ_PASSWORD.
MESSENGER_TRANSPORT_DSN=amqp://booking:change_me_rabbit_password@rabbitmq:5672/%2f/messages
MESSENGER_TRANSPORT_FAILED_DSN=amqp://booking:change_me_rabbit_password@rabbitmq:5672/%2f/failed
###< symfony/messenger ###

###> docker compose ###
# Host port mapped to nginx inside the app container.
APP_HTTP_PORT=80
###< docker compose ###
